GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
GEMINI_INPUT_USD_PER_MILLION=
GEMINI_OUTPUT_USD_PER_MILLION=

# ── Telemetry / Grafana ────────────────────────────────────────────────────────
# Optional: set to protect /api/metrics with bearer-token auth.
# Must match the Prometheus prometheus.yml authorization.credentials value.
METRICS_TOKEN=

# Grafana admin credentials (used in docker-compose.observability.yml)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_in_production
